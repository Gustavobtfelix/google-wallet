# Copie para .env e ajuste os valores.
FLASK_APP=wsgi.py
SECRET_KEY=troque-por-uma-chave-aleatoria
COMPANY_NAME=Minha Empresa
BASE_URL=http://localhost:5000
TIMEZONE=America/Sao_Paulo

# Banco de dados. Sem DATABASE_URL usa SQLite em instance/visitantes.db
# DATABASE_URL=mssql+pyodbc://sa:SuaSenha%40123@localhost:1433/visitantes?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Google Wallet (deixe vazio para o modo demonstração)
WALLET_ISSUER_ID=
WALLET_CLASS_SUFFIX=cartao_visitante
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
WALLET_LOGO_URL=
WALLET_BG_COLOR=#1a73e8

# E-mail (vazio = mensagens apenas no log)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_SENDER=nao-responda@exemplo.com
REMINDER_HOURS_BEFORE=24
